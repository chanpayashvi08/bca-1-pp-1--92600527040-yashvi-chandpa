 //wap input two values and check the first number is divisible by second number
 #include<stdio.h>
 #include<conio.h>
 void main()
 {
	int a,b;
	printf("enter two numbers:");
	scanf("%d%d",&a,&b);
	if(a%b==0)
	{
		printf("first number is divisible by second number");
	}
	else
	{
		printf("first number is not divisible by second number");
	}
	getch();
}